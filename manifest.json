{
  "manifest_version": 3,
  "name": "Bihar RTPS AutoFill",
  "version": "1.0.0",
  "description": "Automate form-filling on Bihar RTPS (ServicePlus) portal for Residence, Caste, Income, and Central NCL certificates.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://serviceonline.bihar.gov.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/serviceplus-logo.png",
      "48": "icons/serviceplus-logo.png",
      "128": "icons/serviceplus-logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://serviceonline.bihar.gov.in/*"],
      "js": ["transliterate.js", "autofill.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/serviceplus-logo.png",
    "48": "icons/serviceplus-logo.png",
    "128": "icons/serviceplus-logo.png"
  }
}
